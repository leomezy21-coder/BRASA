# Configuración de BRASA - CODE RED (NASA Space Apps Challenge 2026)
# URL del backend FastAPI (local o desplegado en Render)
VITE_API_URL=http://localhost:8000

# Modo de operación:
# false = Modo Real (consulta datos verificados de NASA FIRMS en el backend)
# true  = Modo Demo / Simulación (datos deterministas de respaldo)
VITE_USE_MOCK=false
